rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /agrico_memberships/{uid} {
      // Reading an inactive profile lets the app revoke its previous cache.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    // Legacy global collections are closed until scoped sync is implemented.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
